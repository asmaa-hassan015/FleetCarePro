@model ServiceCategory

<section class="ah-section" style="padding-top: 3rem;">
    <div class="container" style="max-width: 600px;">

        <div class="ah-section-head mb-5 text-center">
            <span class="ah-eyebrow center d-inline-flex">FleetCare Pro</span>
            <h2 class="ah-section-title">Add New Service Category</h2>
            <p class="ah-section-sub mx-auto">Create a new category to organize your fleet maintenance services effectively.</p>
        </div>

        <div class="ah-card reveal">
            <div class="ah-card-body p-4 p-md-5">

                <form asp-action="AddNew" asp-controller="ServiceCategory" method="post">

                    <partial name="_ServiceCategoryFormPV" model="Model" />

                    <div class="ah-divider my-4"></div>

                    <div class="d-flex gap-3">
                        <a asp-action="GetAll" class="btn btn-ghost w-50">Cancel</a>
                        <button type="submit" class="btn btn-ah w-50">Submit</button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</section>