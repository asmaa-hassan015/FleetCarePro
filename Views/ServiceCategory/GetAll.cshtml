@model List<ServiceCategory>

@{
    ViewData["Title"] = "Service Categories";
}

<div class="ah-page-head mb-4">

    <nav class="ah-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home"
           asp-action="Index">
            Home
        </a>

        <span class="sep">/</span>

        <span>Service Categories</span>
    </nav>

    <h1 class="ah-section-title">
        Service Categories
    </h1>

    <p class="ah-section-sub">
        Manage and monitor all maintenance categories for your fleet.
    </p>

</div>


@if (TempData["Message"] != null)
{
    <div class="mb-4 p-3 d-flex align-items-center gap-2"
         style="background: rgba(30,196,122,0.1);
        border: 1px solid rgba(30,196,122,0.4);
        color: #7ff0b8;
        border-radius: 10px;
        font-size: .95rem;">

        <svg width="18"
             height="18"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2">

            <circle cx="12"
                    cy="12"
                    r="10" />

            <path d="M8 12l3 3 5-6" />

        </svg>

        @TempData["Message"]

    </div>
}


<div class="ah-toolbar mb-4">

    <a asp-controller="ServiceCategory"
       asp-action="Add"
       class="btn btn-ah btn-sm">

        <svg width="15"
             height="15"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             class="me-1">

            <path d="M12 5v14M5 12h14" />

        </svg>

        Add Service Category

    </a>


    <span style="color:var(--ah-muted);
        font-size:.9rem;">

        <strong style="color:var(--ah-white);">
            @Model.Count
        </strong>

        categories

    </span>

</div>


<div class="ah-card reveal p-0 overflow-hidden">

    <div class="table-responsive">

        <table class="table table-dark table-hover mb-0 align-middle"
               style="background: transparent;">

            <thead>

                <tr style="border-bottom: 1px solid var(--ah-line);
                    color: var(--ah-silver);
                    font-size: .8rem;
                    text-transform: uppercase;
                    letter-spacing: .05em;">

                    <th class="py-3 px-4">
                        #
                    </th>

                    <th class="py-3 px-4">
                        Category Name
                    </th>

                    <th class="py-3 px-4">
                        Description
                    </th>

                    <th class="py-3 px-4">
                        Interval (Months)
                    </th>

                    <th class="py-3 px-4 text-end">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var category in Model)
                {
                    <tr style="border-bottom: 1px solid var(--ah-line);">

                        <th scope="row"
                            class="py-3 px-4"
                            style="color: var(--ah-muted);">

                            @category.Id

                        </th>


                        <td class="py-3 px-4 fw-semibold"
                            style="color: var(--ah-white);">

                            @category.CategoryName

                        </td>


                        <td class="py-3 px-4"
                            style="color: var(--ah-silver);">

                            @(string.IsNullOrEmpty(category.Description)
                                ? "—"
                                : category.Description)

                        </td>


                        <td class="py-3 px-4"
                            style="color: var(--ah-silver);">

                            @category.RecommendedIntervalMonths

                        </td>


                        <td class="py-3 px-4 text-end">

                            <div class="d-flex gap-2 justify-content-end">

                                <a asp-controller="ServiceCategory"
                                   asp-action="Details"
                                   asp-route-id="@category.Id"
                                   class="btn btn-ghost btn-sm">

                                    Details

                                </a>


                                <a asp-controller="ServiceCategory"
                                   asp-action="Update"
                                   asp-route-id="@category.Id"
                                   class="btn btn-ghost btn-sm"
                                   style="border-color:rgba(255,180,0,0.4);
                                    color:#ffd166;">

                                    Update

                                </a>


                                <form asp-controller="ServiceCategory"
                                      asp-action="Delete"
                                      asp-route-id="@category.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this service category? This action cannot be undone.');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-ghost btn-sm"
                                            style="border-color:rgba(255,90,95,0.4);
                                             color:#ff8488;">

                                        Delete

                                    </button>
                                </form>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


@if (!Model.Any())
{
    <div class="ah-empty mt-4">
        No service categories found.
    </div>
}