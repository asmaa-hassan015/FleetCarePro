@model FleetCarePro.ViewModels.VehicleViewModel

<form asp-controller="Vehicle"
      asp-action="AddNew"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <partial name="_VehicleFormPV"
             model="Model" />

    <div class="ah-divider my-4"></div>

    <div class="d-flex flex-wrap align-items-center justify-content-end gap-3">

        <a asp-controller="Vehicle"
           asp-action="GetAll"
           class="btn btn-ghost px-4">
            Cancel
        </a>

        <button type="submit"
                class="btn btn-ah px-5">
            Add Vehicle
        </button>

    </div>

</form>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}