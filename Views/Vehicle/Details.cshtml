@model FleetCarePro.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="container">

    <div class="ah-section-head mb-5">

        <span class="ah-eyebrow">
            FleetCare Pro
        </span>

        <h2 class="ah-section-title">
            Vehicle Details
        </h2>

        <p class="ah-section-sub">
            View complete information about this vehicle.
        </p>

    </div>


    <div class="ah-card reveal">

        <div class="row g-0 align-items-center">

            <!-- Vehicle Image -->
            <div class="col-lg-5">

                <div class="p-4">

                    @if (!string.IsNullOrEmpty(Model.VehicleImageURL))
                    {
                        <img src="@Model.VehicleImageURL"
                             class="img-fluid rounded-4"
                             style="width:100%; height:320px; object-fit:cover;"
                             alt="@Model.Make @Model.Model" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center rounded-4"
                             style="height:320px;
                            background:var(--ah-charcoal);
                            color:var(--ah-muted);">
                            No Image Available
                        </div>
                    }

                </div>

            </div>


            <!-- Vehicle Details -->
            <div class="col-lg-7">

                <div class="ah-card-body">

                    <span class="ah-card-year">
                        @Model.Year · @Model.LicensePlate
                    </span>

                    <h3 class="ah-card-title">
                        @Model.Make @Model.Model
                    </h3>


                    <div class="ah-spec-row mt-3">

                        <span class="ah-spec">
                            VIN: @Model.VIN
                        </span>

                        <span class="ah-spec">
                            Mileage: @Model.Mileage.ToString("N0") KM
                        </span>

                        <span class="ah-spec">
                            Status: @Model.Status
                        </span>

                        <span class="ah-spec">
                            Driver:
                            @(Model.Driver?.FullName ?? "No Driver")
                        </span>

                    </div>


                    <div class="mt-4">

                        <div class="ah-card-price">
                            @Model.PurchasePrice.ToString("C")
                        </div>

                        <p class="mt-3"
                           style="color:var(--ah-muted);">

                            <strong style="color:var(--ah-white);">
                                Purchase Price:
                            </strong>

                            @Model.PurchasePrice.ToString("C")

                        </p>

                        <p style="color:var(--ah-muted);">

                            <strong style="color:var(--ah-white);">
                                Service Records:
                            </strong>

                            @(Model.ServiceRecords?.Count() ?? 0)

                        </p>

                    </div>


                    <div class="ah-card-actions mt-4">

                        <a asp-controller="Vehicle"
                           asp-action="GetAll"
                           class="btn btn-ghost btn-sm">

                            Back to List

                        </a>


                        @if (User.IsInRole("Admin") ||
                             User.IsInRole("FleetManager"))
                        {
                            <a asp-controller="Vehicle"
                               asp-action="Update"
                               asp-route-id="@Model.Id"
                               class="btn btn-ah btn-sm">

                                Edit Vehicle

                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>