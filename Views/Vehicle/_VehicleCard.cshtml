@model FleetCarePro.Models.Vehicle

<div class="ah-card reveal in">

<div class="ah-card-media">

    @if (!string.IsNullOrEmpty(Model.VehicleImageURL))
    {
        <img src="@Model.VehicleImageURL"
             alt="@Model.Make @Model.Model"
             loading="lazy">
    }
    else
    {
        <div style="width:100%;
            height:100%;
            display:grid;
            place-items:center;
            background:var(--ah-charcoal);">

            <svg width="48"
                 height="48"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="var(--ah-line)"
                 stroke-width="1.5">

                <path d="M3 13l2-5.5A2 2 0 0 1 6.9 6h10.2a2 2 0 0 1 1.9 1.5L21 13v5a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H6v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5z" />

                <circle cx="7" cy="15" r="1.3" />
                <circle cx="17" cy="15" r="1.3" />

            </svg>

        </div>
    }

    @{
        var badgeColor = Model.Status switch
        {
            VehicleStatus.Active =>
                "background:rgba(30,196,122,.9);color:#04150c;",

            VehicleStatus.InService =>
                "background:rgba(255,180,0,.9);color:#1a1000;",

            VehicleStatus.Decommissioned =>
                "background:rgba(125,135,152,.6);color:white;",

            _ => ""
        };
    }

    <span class="ah-badge" style="@badgeColor">
        @Model.Status
    </span>

</div>

<div class="ah-card-body">

    <span class="ah-card-year">
        @Model.Year · @Model.LicensePlate
    </span>

    <h3 class="ah-card-title">
        @Model.Make @Model.Model
    </h3>

    <div class="ah-spec-row">

        <span class="ah-spec">
            Mileage: @Model.Mileage.ToString("N0") KM
        </span>

        <span class="ah-spec">
            @(Model.Driver?.FullName ?? "No Driver")
        </span>

        <span class="ah-spec"
              style="grid-column:1/-1;
            font-size:.75rem;
            color:var(--ah-muted);">
            VIN: @Model.VIN
        </span>

    </div>

    <div class="ah-card-actions">

        <a asp-controller="Vehicle"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-ghost btn-sm">
            Details
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("FleetManager"))
        {
            <a asp-controller="Vehicle"
               asp-action="Update"
               asp-route-id="@Model.Id"
               class="btn btn-ghost btn-sm">
                Update
            </a>

            @if (Model.Status != VehicleStatus.Decommissioned)
            {
                <form asp-controller="Vehicle"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Are you sure you want to decommission this vehicle? It will be marked as retired but its service history will be kept.');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-ghost btn-sm">
                        Decommission
                    </button>

                </form>
            }
        }

    </div>

</div>

</div>