@model List<FleetCarePro.Models.ServiceCenter>

@{
    ViewData["Title"] = "Service Centers";
}

<div class="ah-page-head mb-4">

    <nav class="ah-breadcrumb" aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Index">
            Home
        </a>

        <span class="sep">/</span>

        <span>Service Centers</span>

    </nav>

    <h1 class="ah-section-title">
        Service Centers
    </h1>

    <p class="ah-section-sub">
        Manage and monitor all maintenance centers for your fleet.
    </p>

</div>


@if (TempData["Message"] != null)
{
    <div class="mb-4 p-3 d-flex align-items-center gap-2"
         style="background: rgba(30,196,122,0.1);
        border: 1px solid rgba(30,196,122,0.4);
        color: #7ff0b8;
        border-radius: 10px;
        font-size: .95rem;">

        <svg width="18"
             height="18"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2">

            <circle cx="12"
                    cy="12"
                    r="10" />

            <path d="M8 12l3 3 5-6" />

        </svg>

        @TempData["Message"]

    </div>
}


<div class="ah-toolbar mb-4">

    <div class="d-flex gap-2 flex-wrap">

        @if (User.IsInRole("Admin") ||
             User.IsInRole("FleetManager"))
        {
            <a asp-controller="ServiceCenter"
               asp-action="Add"
               class="btn btn-ah btn-sm">

                <svg width="15"
                     height="15"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="me-1">

                    <path d="M12 5v14M5 12h14" />

                </svg>

                Add Service Center

            </a>
        }

    </div>


    <span style="color:var(--ah-muted);
        font-size:.9rem;">

        <strong style="color:var(--ah-white);">
            @Model.Count
        </strong>

        centers

    </span>

</div>


@if (Model.Any())
{
    <div class="ah-card reveal p-0 overflow-hidden">

        <div class="table-responsive">

            <table class="table table-dark table-hover mb-0 align-middle"
                   style="background: transparent;">

                <thead>

                    <tr style="border-bottom: 1px solid var(--ah-line);
                        color: var(--ah-silver);
                        font-size: .8rem;
                        text-transform: uppercase;
                        letter-spacing: .05em;">

                        <th class="py-3 px-4">
                            #
                        </th>

                        <th class="py-3 px-4">
                            Name
                        </th>

                        <th class="py-3 px-4">
                            Phone
                        </th>

                        <th class="py-3 px-4">
                            Email
                        </th>

                        <th class="py-3 px-4">
                            Address
                        </th>

                        <th class="py-3 px-4">
                            Status
                        </th>

                        <th class="py-3 px-4 text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var center in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--ah-line);">

                            <th scope="row"
                                class="py-3 px-4"
                                style="color: var(--ah-muted);">

                                @center.Id

                            </th>


                            <td class="py-3 px-4 fw-semibold"
                                style="color: var(--ah-white);">

                                @center.Name

                            </td>


                            <td class="py-3 px-4"
                                style="color: var(--ah-silver);">

                                @(string.IsNullOrEmpty(center.PhoneNumber)
                                    ? "—"
                                    : center.PhoneNumber)

                            </td>


                            <td class="py-3 px-4"
                                style="color: var(--ah-silver);">

                                @(string.IsNullOrEmpty(center.Email)
                                    ? "—"
                                    : center.Email)

                            </td>


                            <td class="py-3 px-4"
                                style="color: var(--ah-silver);">

                                @(string.IsNullOrEmpty(center.Address)
                                    ? "—"
                                    : center.Address)

                            </td>


                            <td class="py-3 px-4">

                                @if (center.IsActive)
                                {
                                    <span class="ah-pill"
                                          style="background:rgba(30,196,122,.9);
                                        color:#04150c;
                                        font-size:.7rem;
                                        padding:.25rem .6rem;">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="ah-pill"
                                          style="background:rgba(125,135,152,.6);
                                        color:white;
                                        font-size:.7rem;
                                        padding:.25rem .6rem;">

                                        Inactive

                                    </span>
                                }

                            </td>


                            <td class="py-3 px-4 text-end">

                                <div class="d-flex gap-2 justify-content-end">

                                    <a asp-controller="ServiceCenter"
                                       asp-action="Details"
                                       asp-route-id="@center.Id"
                                       class="btn btn-ghost btn-sm">

                                        Details

                                    </a>


                                    @if (User.IsInRole("Admin") ||
                                         User.IsInRole("FleetManager"))
                                    {
                                        <a asp-controller="ServiceCenter"
                                           asp-action="Update"
                                           asp-route-id="@center.Id"
                                           class="btn btn-ghost btn-sm"
                                           style="border-color:rgba(255,180,0,0.4);
                                            color:#ffd166;">

                                            Update

                                        </a>


                                        <form asp-controller="ServiceCenter"
                                              asp-action="Delete"
                                              asp-route-id="@center.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this service center? This action cannot be undone.');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-ghost btn-sm"
                                                    style="border-color:rgba(255,90,95,0.4);
                                                     color:#ff8488;">

                                                Delete

                                            </button>
                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}
else
{
    <div class="ah-empty mt-4">
        No service centers found.
    </div>
}