@{
    Layout = null;
    ViewData["Title"] = "Maintenance";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>FleetCare Pro - Maintenance</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #0b0f14;
                color: #ffffff;
                font-family: Arial, sans-serif;
            }

            .maintenance-container {
                width: 90%;
                max-width: 650px;
                text-align: center;
                padding: 3rem 2rem;
                background: #151b23;
                border: 1px solid #293241;
                border-radius: 16px;
            }

            .eyebrow {
                display: inline-block;
                margin-bottom: 1rem;
                color: #2f6bff;
                font-size: .8rem;
                font-weight: 700;
                letter-spacing: .12em;
                text-transform: uppercase;
            }

            h1 {
                margin-bottom: 1rem;
                color: #ffffff;
                font-size: 2.5rem;
            }

            .highlight {
                color: #2f6bff;
            }

            p {
                margin: 0 auto 1.5rem;
                color: #9aa4b2;
                line-height: 1.7;
                max-width: 520px;
            }

            .status {
                display: inline-block;
                padding: .6rem 1rem;
                border-radius: 8px;
                background: rgba(47, 107, 255, .12);
                border: 1px solid rgba(47, 107, 255, .3);
                color: #6f98ff;
                font-size: .9rem;
            }
    </style>
</head>

<body>

    <main class="maintenance-container">

        <span class="eyebrow">
            FleetCare Pro
        </span>

        <h1>
            System <span class="highlight">Maintenance</span>
        </h1>

        <p>
            FleetCare Pro is temporarily unavailable while we perform
            scheduled maintenance and system updates.
        </p>

        <p>
            Please check back shortly. We apologize for any inconvenience.
        </p>

        <span class="status">
            Maintenance in progress
        </span>

    </main>

</body>
</html>