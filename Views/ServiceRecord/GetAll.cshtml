@model List<FleetCarePro.Models.ServiceRecord>

@{
    ViewData["Title"] = "Service Records";
}

<div class="ah-page-head mb-4">

    <nav class="ah-breadcrumb" aria-label="Breadcrumb">

        <a asp-controller="Home"
           asp-action="Index">
            Home
        </a>

        <span class="sep">/</span>

        <span>Service Records</span>

    </nav>

    <h1 class="ah-section-title">
        Service Records
    </h1>

    <p class="ah-section-sub">
        Manage and track all vehicle maintenance and service history.
    </p>

</div>


@if (TempData["Message"] != null)
{
    <div class="mb-4 p-3 d-flex align-items-center gap-2"
         style="background: rgba(30,196,122,0.1);
        border: 1px solid rgba(30,196,122,0.4);
        color: #7ff0b8;
        border-radius: 10px;
        font-size: .95rem;">

        <svg width="18"
             height="18"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2">

            <circle cx="12"
                    cy="12"
                    r="10" />

            <path d="M8 12l3 3 5-6" />

        </svg>

        @TempData["Message"]

    </div>
}


<div class="ah-toolbar mb-4">

    <a asp-controller="ServiceRecord"
       asp-action="Add"
       class="btn btn-ah btn-sm">

        <svg width="15"
             height="15"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             class="me-1">

            <path d="M12 5v14M5 12h14" />

        </svg>

        Add Service Record

    </a>


    <span style="color:var(--ah-muted);
        font-size:.9rem;">

        <strong style="color:var(--ah-white);">
            @(Model?.Count ?? 0)
        </strong>

        records

    </span>

</div>


<div class="ah-card reveal p-0 overflow-hidden">

    <div class="table-responsive">

        <table class="table table-dark table-hover mb-0 align-middle"
               style="background: transparent;">

            <thead>

                <tr style="border-bottom: 1px solid var(--ah-line);
                    color: var(--ah-silver);
                    font-size: .8rem;
                    text-transform: uppercase;
                    letter-spacing: .05em;">

                    <th class="py-3 px-4">
                        #
                    </th>

                    <th class="py-3 px-4">
                        Vehicle
                    </th>

                    <th class="py-3 px-4">
                        Service Center
                    </th>

                    <th class="py-3 px-4">
                        Date
                    </th>

                    <th class="py-3 px-4">
                        Mileage
                    </th>

                    <th class="py-3 px-4">
                        Total Cost
                    </th>

                    <th class="py-3 px-4">
                        Status
                    </th>

                    <th class="py-3 px-4 text-end">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var record in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--ah-line);">

                            <th scope="row"
                                class="py-3 px-4"
                                style="color: var(--ah-muted);">

                                @record.Id

                            </th>


                            <td class="py-3 px-4">

                                <div class="fw-semibold"
                                     style="color: var(--ah-white);">

                                    @record.Vehicle?.Make
                                    @record.Vehicle?.Model

                                </div>

                                <small style="color: var(--ah-muted);">

                                    @record.Vehicle?.LicensePlate

                                </small>

                            </td>


                            <td class="py-3 px-4"
                                style="color: var(--ah-silver);">

                                @(record.ServiceCenter?.Name ?? "—")

                            </td>


                            <td class="py-3 px-4"
                                style="color: var(--ah-silver);">

                                @record.ServiceDate.ToShortDateString()

                            </td>


                            <td class="py-3 px-4">

                                <span class="ah-pill"
                                      style="background:var(--ah-surface, #151922);
                                    color:var(--ah-white);
                                    border:1px solid var(--ah-line, #333);
                                    font-size:.7rem;
                                    padding:.25rem .6rem;">

                                    @record.CurrentMileage.ToString("N0") km

                                </span>

                            </td>


                            <td class="py-3 px-4 fw-bold"
                                style="color: #7ff0b8;">

                                @record.TotalCost.ToString("C")

                            </td>


                            <td class="py-3 px-4">

                                @{
                                    var statusStyle = record.Status switch
                                    {
                                        ServiceRecordStatus.Pending =>
                                            "background:rgba(255,180,0,.9);color:#04150c;",

                                        ServiceRecordStatus.Approved =>
                                            "background:rgba(47,107,255,.9);color:#04150c;",

                                        ServiceRecordStatus.Completed =>
                                            "background:rgba(30,196,122,.9);color:#04150c;",

                                        ServiceRecordStatus.Cancelled =>
                                            "background:rgba(255,90,95,.9);color:#04150c;",

                                        _ => "background:rgba(125,135,152,.6);color:white;"
                                    };
                                }

                                <span class="ah-pill"
                                      style="@statusStyle
                                        font-size:.7rem;
                                        padding:.25rem .6rem;">

                                    @record.Status

                                </span>

                            </td>


                            <td class="py-3 px-4 text-end">

                                <div class="d-flex gap-2 justify-content-end">

                                    @if (record.Status == ServiceRecordStatus.Pending)
                                    {
                                        <form asp-controller="ServiceRecord"
                                              asp-action="Approve"
                                              asp-route-id="@record.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-ghost btn-sm"
                                                    style="border-color:rgba(30,196,122,0.4);
                                                     color:#7ff0b8;"
                                                    title="Approve">

                                                Approve

                                            </button>
                                        </form>
                                    }


                                    <a asp-controller="ServiceRecord"
                                       asp-action="Details"
                                       asp-route-id="@record.Id"
                                       class="btn btn-ghost btn-sm">

                                        Details

                                    </a>


                                    <a asp-controller="ServiceRecord"
                                       asp-action="Update"
                                       asp-route-id="@record.Id"
                                       class="btn btn-ghost btn-sm"
                                       style="border-color:rgba(255,180,0,0.4);
                                        color:#ffd166;">

                                        Update

                                    </a>


                                    <form asp-controller="ServiceRecord"
                                          asp-action="Delete"
                                          asp-route-id="@record.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this service record? This action cannot be undone.');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-ghost btn-sm"
                                                style="border-color:rgba(255,90,95,0.4);
                                                 color:#ff8488;">

                                            Delete

                                        </button>
                                    </form>

                                </div>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>


@if (Model == null || !Model.Any())
{
    <div class="ah-empty mt-4 text-center py-4"
         style="color: var(--ah-muted);">

        No service records found.

    </div>
}