@model ServiceRecordViewModel

@using System.Text.Json

<!-- Main Content Container -->
<div class="container mb-5">

    <div class="mb-4">
        <a asp-controller="ServiceRecord"
           asp-action="GetAll"
           class="btn btn-outline-light btn-sm px-3">
            <i class="fas fa-arrow-left me-2"></i>
            Back to List
        </a>
    </div>


    <div class="card bg-dark text-white border-secondary shadow-lg rounded-4 overflow-hidden">

        <div class="card-header bg-secondary bg-opacity-25 py-3 px-4 border-bottom border-secondary">

            <h5 class="fw-semibold text-white mb-0">
                <i class="fas fa-plus-circle me-2 text-primary"></i>
                Service Record Details
            </h5>

        </div>


        <div class="card-body p-4 p-md-5">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger bg-dark text-danger border-danger shadow-sm rounded-3 mb-4">

                    <div asp-validation-summary="All"></div>

                </div>
            }


            <form asp-action="Add"
                  asp-controller="ServiceRecord"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <!-- Vehicle / Service Center / Date -->
                <div class="row g-3 mb-4">

                    <div class="col-md-4">

                        <label asp-for="VehicleId"
                               class="form-label text-secondary fw-semibold">
                            Vehicle
                        </label>

                        <select asp-for="VehicleId"
                                class="form-select bg-dark text-white border-secondary rounded-3">

                            <option value="">
                                -- Select Vehicle --
                            </option>

                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.Id">
                                    @v.Make @v.Model (@v.LicensePlate)
                                </option>
                            }

                        </select>

                        <span asp-validation-for="VehicleId"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="ServiceCenterId"
                               class="form-label text-secondary fw-semibold">
                            Service Center
                        </label>

                        <select asp-for="ServiceCenterId"
                                class="form-select bg-dark text-white border-secondary rounded-3">

                            <option value="">
                                -- Select Service Center --
                            </option>

                            @foreach (var sc in Model.ServiceCenters)
                            {
                                <option value="@sc.Id">
                                    @sc.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="ServiceCenterId"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="ServiceDate"
                               class="form-label text-secondary fw-semibold">
                            Service Date
                        </label>

                        <input asp-for="ServiceDate"
                               type="date"
                               class="form-control bg-dark text-white border-secondary rounded-3" />

                        <span asp-validation-for="ServiceDate"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- Mileage / Notes -->
                <div class="row g-3 mb-4">

                    <div class="col-md-6">

                        <label asp-for="CurrentMileage"
                               class="form-label text-secondary fw-semibold">
                            Current Mileage
                        </label>

                        <input asp-for="CurrentMileage"
                               type="number"
                               class="form-control bg-dark text-white border-secondary rounded-3"
                               placeholder="e.g. 15000" />

                        <span asp-validation-for="CurrentMileage"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Notes"
                               class="form-label text-secondary fw-semibold">
                            Notes
                        </label>

                        <input asp-for="Notes"
                               class="form-control bg-dark text-white border-secondary rounded-3"
                               placeholder="Add any specific remarks..." />

                        <span asp-validation-for="Notes"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- Invoice -->
                <div class="mb-4">

                    <label asp-for="InvoiceDocument"
                           class="form-label text-secondary fw-semibold">
                        Invoice Document
                    </label>

                    <input asp-for="InvoiceDocument"
                           type="file"
                           class="form-control bg-dark text-white border-secondary rounded-3"
                           accept=".pdf,.jpg,.jpeg,.png" />

                    <span asp-validation-for="InvoiceDocument"
                          class="text-danger small">
                    </span>

                </div>


                <hr class="my-4 border-secondary" />


                <!-- Line Items -->
                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h5 class="fw-semibold text-white mb-0">
                        <i class="fas fa-list-ul me-2 text-info"></i>
                        Service Line Items
                    </h5>

                    <button type="button"
                            id="addLineItemBtn"
                            class="btn btn-outline-info btn-sm px-3 rounded-pill">

                        <i class="fas fa-plus me-1"></i>
                        Add Line Item

                    </button>

                </div>


                <div class="table-responsive border border-secondary rounded-3 mb-4">

                    <table class="table table-dark table-hover align-middle mb-0"
                           id="lineItemsTable">

                        <thead class="table-secondary text-dark text-uppercase fs-7">

                            <tr>

                                <th class="ps-3"
                                    style="width: 35%;">
                                    Category
                                </th>

                                <th style="width: 40%;">
                                    Description
                                </th>

                                <th style="width: 15%;">
                                    Cost
                                </th>

                                <th class="text-center"
                                    style="width: 10%;">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody id="lineItemsBody">
                        </tbody>

                    </table>

                </div>


                <button type="submit"
                        class="btn btn-primary w-100 py-2 fw-semibold shadow-sm rounded-3">

                    <i class="fas fa-save me-2"></i>
                    Submit Service Record

                </button>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const serviceCategories =
                    @Html.Raw(
                            JsonSerializer.Serialize(
                                    Model.ServiceCategories.Select(c => new
                    {
                        id = c.Id,
                                            name = c.CategoryName
                    })
    )
    );


        function buildCategoryOptions() {

            let options =
                '<option value="">-- Select Category --</option>';

            serviceCategories.forEach(function(cat) {

                options +=
                    '<option value="' +
                    cat.id +
                    '">' +
                    cat.name +
                    '</option>';

            });

            return options;
        }


        // Adds a new row WITHOUT an index in the name attributes.
        // The real, gap-free index is assigned by reindexRows()
        // right after, so ServiceLineItems[0], [1], [2]... are
        // always contiguous no matter what gets added/removed.
        function addLineItemRow() {

            const tbody =
                document.querySelector("#lineItemsBody");

            const row =
                document.createElement("tr");

            row.className = "line-item-row";


            row.innerHTML =

                '<td class="ps-3">' +

                '<select data-field="ServiceCategoryId" ' +

                'class="form-select form-select-sm bg-dark text-white border-secondary rounded-3">' +

                buildCategoryOptions() +

                '</select>' +

                '</td>' +


                '<td>' +

                '<input data-field="Description" ' +

                'class="form-control form-control-sm bg-dark text-white border-secondary rounded-3" ' +

                'placeholder="Item description" />' +

                '</td>' +


                '<td>' +

                '<input data-field="Cost" ' +

                'type="number" ' +
                'step="0.01" ' +

                'class="form-control form-control-sm bg-dark text-white border-secondary rounded-3" ' +

                'placeholder="0.00" />' +

                '</td>' +


                '<td class="text-center">' +

                '<button type="button" ' +
                'class="btn btn-outline-danger btn-sm removeLineItemBtn" ' +
                'title="Remove">' +

                '<i class="fas fa-trash-alt"></i>' +

                '</button>' +

                '</td>';


            tbody.appendChild(row);

            reindexRows();
        }


        // Walks every row currently in the table (in DOM order)
        // and rewrites its "name" attributes using a fresh,
        // contiguous 0..N-1 index. This runs after every add
        // and every remove, so the model binder never sees a gap.
        function reindexRows() {

            const rows =
                document.querySelectorAll(
                    "#lineItemsBody .line-item-row");

            rows.forEach(function(row, index) {

                row.querySelectorAll("[data-field]")
                    .forEach(function(field) {

                        const fieldName =
                            field.getAttribute("data-field");

                        field.name =
                            "ServiceLineItems[" +
                            index +
                            "]." +
                            fieldName;

                    });

            });
        }


        document
            .getElementById("addLineItemBtn")
            .addEventListener("click", addLineItemRow);


        document
            .getElementById("lineItemsTable")
            .addEventListener("click", function(e) {

                const btn =
                    e.target.closest(".removeLineItemBtn");


                if (btn) {

                    btn.closest("tr").remove();

                    reindexRows();

                }

            });


        // Add first empty row
        addLineItemRow();

    </script>
}